# secrets
.env
.streamlit/secrets.toml

# model weights, local database
*.pt
*.db

# camera media (never store footage in the repo)
*.mp4
*.avi
*.jpg
*.jpeg
*.png

# generated reports
*.pdf
hfm_energy_report*.csv
reports/

# python
__pycache__/
*.pyc

# Gemma 4 room-check log
gemma_checks.jsonl

# survey output and runtime state (local to one machine, not the project)
scan_*/
review_frames/
room_state.json

snapshots/

# evidence frames from --evidence (unblurred; never committed)
evidence/

# verify_live.py's pictures of the rooms it disagreed with -- unblurred,
# and taken while people are at their desks, which is the whole point of
# them. They settle an argument on this machine and go no further.
frames/verify/

# pack_evidence.py output -- unblurred pictures, for a reviewer only
evidence_pack_*.zip

# ac_survey.py and field_audit.py output -- full-size, unblurred frames of
# rooms with people in them. They go to a reviewer, never into git.
ac_survey/
ac_survey_*.zip
field_audit_*/
field_audit_*.zip
frames/*.zip
